# Copie para .env e ajuste. Nenhum valor real é versionado.
APP_ENV=dev
SECRET_KEY=troque-por-uma-chave-aleatoria-longa
DATABASE_URL=sqlite:///instance/prontuario.db
# Produção (PostgreSQL):
# DATABASE_URL=postgresql://usuario:senha@host:5432/prontuario_db

# Pool (só vale para Postgres). (pool_size + max_overflow) x workers do Procfile
# precisa caber no max_connections do servidor.
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=15

# Backup. Só necessário se o pg_dump não estiver no PATH nem no diretório
# padrão de instalação.
# PG_DUMP_PATH=C:\Program Files\PostgreSQL\16\bin\pg_dump.exe
# BACKUP_DIR=backups

# RNDS (Rede Nacional de Dados em Saúde).
# Sem estas três, o sistema usa um cliente SIMULADO: nada sai da máquina e os
# protocolos vêm prefixados com SIM-. Os endereços abaixo são de HOMOLOGAÇÃO;
# confira os caminhos contra o manual vigente antes de apontar para produção.
# RNDS_AUTH_URL=https://ehr-auth-hmg.saude.gov.br/api/token
# RNDS_EHR_URL=https://ehr-services-hmg.saude.gov.br/api/fhir/r4
# Certificado ICP-Brasil do estabelecimento, em PEM. Se a chave privada estiver
# num arquivo separado, informe as duas.
# RNDS_CERTIFICADO=/caminho/certificado.pem
# RNDS_CHAVE_PRIVADA=/caminho/chave.pem
# RNDS_REQUISITANTE_CNS=000000000000000
# RNDS_TIMEOUT=30
# O nome do cabeçalho do token mudou entre versões do manual.
# RNDS_CABECALHO_TOKEN=Authorization
