# Python
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/

# Ambiente e segredos
.env
.env.*
# O modelo não tem segredo e precisa ser versionado — é dele que se copia o .env.
!.env.example

# Banco de dados local
instance/
*.db
*.sqlite
*.sqlite3

# Cópias de segurança geradas pela tela /backup
backups/
*.dump

# Testes
.pytest_cache/
.coverage
htmlcov/

# Editor
.vscode/
.idea/

# Sistema operacional
.DS_Store
Thumbs.db

# Logs
*.log

# Node (caso use futuramente)
node_modules/
.next/

# Monografia gerada a partir de docs/TCC.md por
# scripts/gerar_tcc_docx.py. A FONTE e o gerador sao versionados;
# o binario nao, porque diff de .docx nao se le e o arquivo muda a
# cada regeracao.
docs/TCC.docx

# Mesma regra para o roteiro de defesa, gerado de docs/defesa_roteiro.md por
# scripts/gerar_defesa_docx.py.
docs/defesa_roteiro.docx
docs/defesa_slides.pptx

# Mesma regra para o resumo do sistema, gerado por
# scripts/gerar_resumo_pdf.py. O conteudo mora no script.
docs/RESUMO_SISTEMA.pdf

# Mesma regra para o levantamento de leituras, gerado por
# scripts/gerar_leituras_pdf.py. O conteudo mora no script.
docs/LEITURAS.pdf

# Mesma regra para o levantamento do DATASUS: a FONTE e docs/datasus_levantamento.md
# e o gerador e scripts/gerar_datasus_docx.py. Editar o .docx e perder a edicao
# na proxima geracao, com os dois arquivos afirmando coisas diferentes ate la.
docs/datasus_levantamento.docx

# Lock que o LibreOffice cria ao abrir o .docx e deixa para tras quando o
# processo e encerrado a forca. Aparece no `git status` como arquivo novo.
.~lock.*#
